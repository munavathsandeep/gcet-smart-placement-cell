# GCET Placement Hub — Environment Variables Example (Do NOT commit real passwords)
GCET_DB_URL=jdbc:mysql://localhost:3306/gcet_placement_hub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
GCET_DB_USER=YOUR_MYSQL_USERNAME
GCET_DB_PASS=YOUR_MYSQL_PASSWORD

