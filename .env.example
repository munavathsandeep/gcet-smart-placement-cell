# GEMINI_API_KEY: Optional Gemini AI API key when using AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NODE_ENV: Set to "production" when deploying publicly (Render, Railway, Cloud Run, etc.)
NODE_ENV="development"

# PORT: Server listening port (AI Studio & standard PaaS default is 3000 or injected PORT)
PORT="3000"

# APP_URL: Public deployment URL where this portal is hosted (no trailing slash)
APP_URL="MY_APP_URL"

# CORS_ORIGIN: Comma-separated allowed browser origins in production (defaults to APP_URL + same-origin)
CORS_ORIGIN=""

# SESSION_SECRET: Strong random 32+ char secret for HMAC session signing in production
SESSION_SECRET="replace-with-a-strong-random-production-secret"

# DB_PATH: Optional SQLite database file path (e.g., persistent disk /var/data/gcet_career_connect.db)
DB_PATH="./data/gcet_career_connect.db"

